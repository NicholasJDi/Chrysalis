{
	"uuid":"mpris@chrysalis",
	"name":"MPRIS Integration",
	"description": "Linux MPRIS Integration for Chrysalis",
	"author": "NicholasJDi",
	"version": "0.1.0",
	"permissions": {
		"main": [
			"player:play-pause",
			"player:play",
			"player:pause",
			"player:stop",
			"player:get-time",
			"player:set-time",
			"player:shift-time",
			"player:set-volume",
			"player:next",
			"player:prev",
			"player:loop",
			"player:shuffle",
			"library:open",
			"metadata:flatten",
			"app:raise",
			"app:quit"
		],
		"subscribe": [
			"track-changed",
			"metadata-changed",
			"loop-changed",
			"shuffle-changed",
			"state-changed",
			"position-changed",
			"seeked",
			"volume-changed"
		]
	}
}